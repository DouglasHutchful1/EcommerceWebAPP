        <div class="row text-md-left">
            <div class="col-md-3 col-lg-3 col-xl-3 mx-auto mt-3">
                <h5 class="text-uppercase mb-4 font-weight-bold text-warning"><i class="bi bi-bag-check-fill me-1 text-primary"></i>DawgShop</h5>
