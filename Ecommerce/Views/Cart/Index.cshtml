@model Ecommerce.Models.CartModel

@{
    ViewData["Title"] = "Your Cart";
    Layout = "_Layout";
}
<style>
/* ===== CART ITEM ===== */
.cart-item {
    background: #fff;
    border-radius: 18px;
    transition: transform .2s ease, box-shadow .2s ease;
}

.cart-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 1rem 2.5rem rgba(0,0,0,.08);
}

/* Image */
.cart-img {
    width: 88px;
    height: 88px;
    object-fit: cover;
    border-radius: 14px;
    background: #f1f3f5;
}

/* Quantity input */
.cart-qty {
    width: 70px;
    height: 38px;
    border-radius: 999px;
    font-weight: 600;
    border: 1px solid #dee2e6;
}

/* Price */
.item-total {
    min-width: 90px;
    text-align: right;
    font-weight: 700;
    font-size: 1.05rem;
}

/* Remove button */
.remove-btn {
    width: 36px;
    height: 36px;
    padding: 0;
    display: grid;
    place-items: center;
}

/* ===== CART SUMMARY ===== */
.cart-summary {
    position: sticky;
    top: 110px;
    background: #111827;
    color: #fff;
    border-radius: 22px;
}

.cart-summary h5 {
    font-weight: 700;
}

.cart-summary span.text-muted {
    color: #9ca3af !important;
}

.cart-summary strong {
    font-size: 1.1rem;
}

.cart-summary button {
    background: linear-gradient(135deg, #111827, #1f2937);
    border: none;
}

.empty-cart {
    padding: 4rem 2rem;
    background: #fff;
    border-radius: 24px;
    box-shadow: 0 1rem 2.5rem rgba(0,0,0,.06);
}

/* ===== MOBILE ===== */
@@media (max-width: 991px) {
    .cart-summary {
        position: static;
        margin-top: 2rem;
    }

    .cart-img {
        width: 70px;
        height: 70px;
    }
}

</style>
<div class="container my-5">
    <h1 class="mb-5 text-center">Your Shopping Cart</h1>

    @if (Model.CartItems != null && Model.CartItems.Any())
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="list-group">
                    @foreach (var item in Model.CartItems)
                    {
                       <div class="cart-item card shadow-sm border-0 mb-3 rounded-4">

                           <div class="card-body d-flex gap-4 align-items-center">
                       
                               <img src="@item.Product?.ImageUrl"
                                    class="cart-img rounded-3"
                                    alt="@item.Product?.Name" />
                       
                               <div class="flex-grow-1">
                                 <h6 class="fw-semibold mb-1 text-dark">@item.Product?.Name</h6>

                                   <div class="text-muted small">
                                       $@item.Product?.Price
                                   </div>
                               </div>
                       
                               <div class="d-flex align-items-center gap-2">
                                   <input type="number"
                                          class="form-control form-control-sm text-center cart-qty"
                                          value="@item.Quantity"
                                          min="1"
                                          data-product-id="@item.ProductId"
                                          style="width:70px;" />
                       
                                   <span class="fw-bold item-total"
                                         data-price="@item.Product.Price">
                                       $@(item.Product.Price * item.Quantity)
                                   </span>
                       
                                   <button class="btn btn-outline-danger btn-sm rounded-circle remove-btn"
                                           data-product-id="@item.ProductId"
                                           title="Remove item">
                                       <i class="bi bi-x-lg"></i>
                                   </button>
                               </div>
                       
                           </div>
                       </div>

                    }
                </div>
            </div>

            <div class="card shadow-sm border-0 p-4 cart-summary">
                <h5 class="fw-semibold mb-3">Cart Summary</h5>
            
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Items</span>
                    <strong id="totalItems">@Model.CartItems.Sum(x => x.Quantity)</strong>
                </div>
            
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Total</span>
                    <strong id="totalAmount">
                        $@Model.CartItems.Sum(x => x.Product!.Price * x.Quantity)
                    </strong>
                </div>
            
                <button class="btn btn-dark btn-lg rounded-pill w-100"
                        onclick="location.href='/Checkout'">
                    Checkout
                </button>

            
                <p class="text small text-center mt-3">
                    Secure checkout · Free returns
                </p>
            </div>

        </div>
    }
    else
    {
        <div class="text-center">
            <h2>Your Cart is Empty</h2>
            <a href="/Product"
               class="btn btn-primary btn-lg rounded-pill">
                Start Shopping
            </a>
        </div>
    }
</div>
<script>
function recalcSummary() {
    let totalItems = 0;
    let totalAmount = 0;

    document.querySelectorAll(".cart-qty").forEach(input => {
        const qty = parseInt(input.value) || 0;
        const item = input.closest(".cart-item");
        const price = parseFloat(
            item.querySelector(".item-total").dataset.price
        );

        totalItems += qty;
        totalAmount += qty * price;
    });

    document.getElementById("totalItems").innerText = totalItems;
    document.getElementById("totalAmount").innerText =
        "$" + totalAmount.toFixed(2);
}

/* QUANTITY CHANGE */
document.addEventListener("change", async e => {
    if (!e.target.classList.contains("cart-qty")) return;

    const input = e.target;
    const productId = input.dataset.productId;
    const qty = parseInt(input.value);

    await fetch(`/Cart/Update?productId=${productId}&qty=${qty}`, {
        method: "POST"
    });

    const item = input.closest(".cart-item");
    const price = parseFloat(
        item.querySelector(".item-total").dataset.price
    );

    item.querySelector(".item-total").innerText =
        "$" + (price * qty).toFixed(2);

    recalcSummary();
});

/* REMOVE ITEM */
document.addEventListener("click", async e => {
    const btn = e.target.closest(".remove-btn");
    if (!btn) return;

    const productId = btn.dataset.productId;
    const item = btn.closest(".cart-item");

    await fetch(`/Cart/Remove?productId=${productId}`, {
        method: "POST"
    });

    item.style.opacity = "0";
    setTimeout(() => {
        item.remove();
        recalcSummary();
    }, 200);
});
</script>
