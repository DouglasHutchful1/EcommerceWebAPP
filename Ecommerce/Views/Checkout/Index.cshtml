@model Ecommerce.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
    Layout = "_Layout";
}

<div class="container my-5">
    <h1 class="mb-4 text-center">Checkout</h1>

    <form asp-action="PlaceOrder" method="post">
        <div class="row">
            <!-- LEFT -->
            <div class="col-lg-7">
                <div class="card shadow-sm border-0 p-4 mb-4">
                    <h5 class="mb-3">Shipping Information</h5>

                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input asp-for="FullName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input asp-for="Phone" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <textarea asp-for="Address"
                                  class="form-control"
                                  rows="3"
                                  required></textarea>
                    </div>
                </div>
            </div>

            <!-- RIGHT -->
            <div class="col-lg-5">
                <div class="card shadow-sm border-0 p-4 sticky-top" style="top:100px;">
                    <h5 class="mb-3">Order Summary</h5>

                    @foreach (var item in Model.CartItems)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span>
                                @item.Product!.Name × @item.Quantity
                            </span>
                            <strong>
                                $@(item.Product.Price * item.Quantity)
                            </strong>
                        </div>
                    }

                    <hr />

                    <div class="d-flex justify-content-between">
                        <span>Total Items</span>
                        <strong>@Model.TotalItems</strong>
                    </div>

                    <div class="d-flex justify-content-between fs-5 mt-2">
                        <span>Total</span>
                        <strong>$@Model.TotalAmount</strong>
                    </div>

                    <button class="btn btn-dark btn-lg rounded-pill w-100 mt-4">
                        Place Order
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>
