@model Ecommerce.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
    Layout = "_Layout";
}

<style>
/* ===== CHECKOUT LAYOUT ===== */
.checkout-title {
    font-weight: 800;
    letter-spacing: -.03em;
}

/* Cards */
.checkout-card {
    border-radius: 22px;
}

/* Form inputs */
.checkout-card .form-control {
    border-radius: 14px;
    padding: .65rem .9rem;
}

/* Section titles */
.section-title {
    font-weight: 700;
    margin-bottom: 1.25rem;
}

/* Order summary */
.summary-card {
    background: #111827;
    color: #fff;
    border-radius: 24px;
}

.summary-card span.text-muted {
    color: #9ca3af !important;
}

.summary-item {
    font-size: .95rem;
}

.summary-total {
    font-size: 1.4rem;
    font-weight: 800;
}

/* Button */
.place-order-btn {
    background: linear-gradient(135deg, #2563eb, #1d4ed8); /* blue */
    color: #ffffff;
    border: none;
}

.place-order-btn:hover {
    background: linear-gradient(135deg, #1e40af, #1d4ed8);
    color: #ffffff;
}

/* Mobile */
@@media (max-width: 991px) {
    .summary-card {
        margin-top: 2rem;
    }
}
</style>

<div class="container my-5">
    <h1 class="checkout-title mb-5 text-center">Secure Checkout</h1>

    <form asp-action="PlaceOrder" method="post">
        <div class="row g-4">

            <!-- LEFT : SHIPPING -->
            <div class="col-lg-7">
                <div class="card checkout-card shadow-sm border-0 p-4">
                    <h5 class="section-title">Shipping Information</h5>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Full Name</label>
                            <input asp-for="FullName" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Phone</label>
                            <input asp-for="Phone" class="form-control" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Delivery Address</label>
                            <textarea asp-for="Address"
                                      class="form-control"
                                      rows="3"
                                      required></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT : SUMMARY -->
            <div class="col-lg-5">
                <div class="card summary-card shadow-sm border-0 p-4 sticky-top" style="top:110px;">
                    <h5 class="section-title">Order Summary</h5>

                    @foreach (var item in Model.CartItems)
                    {
                        <div class="d-flex justify-content-between mb-2 summary-item">
                            <span class="text-muted">
                                @item.Product!.Name × @item.Quantity
                            </span>
                            <strong>
                                $@(item.Product.Price * item.Quantity)
                            </strong>
                        </div>
                    }

                    <hr class="border-secondary my-3" />

                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Items</span>
                        <strong>@Model.TotalItems</strong>
                    </div>

                    <div class="d-flex justify-content-between mt-2">
                        <span class="text-muted">Total</span>
                        <span class="summary-total">$@Model.TotalAmount</span>
                    </div>

                    <button class="btn place-order-btn btn-lg rounded-pill w-100 mt-4">
                        Place Order
                    </button>

                    <p class="text small text-center mt-3">
                        Secure payment · Fast delivery
                    </p>
                </div>
            </div>

        </div>
    </form>
</div>
