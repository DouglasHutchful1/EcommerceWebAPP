@model Ecommerce.Models.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

<!-- AOS Animation Library -->
<link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script> AOS.init(); </script>

<!-- HERO CAROUSEL -->
<div class="p-0 mb-5 rounded-3 shadow-lg overflow-hidden position-relative">
    <div id="homeCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-indicators">
            @for (int i = 0; i < 3; i++)
            {
                <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
            }
        </div>

        <div class="carousel-inner">
            @for (int i = 0; i < 3; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="https://images.unsplash.com/photo-1582719188393-bb71ca45dbb9" class="d-block w-100" style="height:450px; object-fit:cover;">
                </div>
            }
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>

        <div class="carousel-caption text-start bg-dark bg-opacity-50 p-4 rounded">
            <h1 class="fw-bold text-white display-5">Discover Amazing Products</h1>
            <p class="text-light">Shop top categories and exclusive deals. Delivered fast to your doorstep.</p>
            <a class="btn btn-warning btn-lg rounded-pill shadow-sm px-4" href="/Products">Start Shopping</a>
        </div>
    </div>
</div>


@*<!-- CATEGORIES -->
<div class="container my-5">
    <h2 class="mb-4 text-center fw-bold" data-aos="fade-up">Browse by Category</h2>
    <div class="row text-center g-4">
        @foreach (var category in Model.Categories)
        {
            <div class="col-md-4" data-aos="fade-up">
                <div class="card border-0 shadow-sm category-card">
                    <img src="@category.ImageUrl" class="card-img-top category-img" alt="@category.Name">
                    <div class="card-body">
                        <h5 class="card-title mb-2">@category.Name</h5>
                        <a href="/Products?categoryId=@category.Id" class="btn btn-outline-dark btn-sm rounded-pill px-4">Explore</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>*@

<!-- FEATURED PRODUCTS -->
<div class="container my-5">
    <h2 class="mb-4 text-center fw-bold" data-aos="fade-up">Featured Products</h2>
    <div class="row row-cols-1 row-cols-md-4 g-4">
        @foreach (var product in Model.FeaturedProducts)
        {
            <div class="col" data-aos="fade-up">
                <div class="card h-100 border-0 shadow-sm product-card">
                    <img src="@product.ImageUrl" class="card-img-top product-img" alt="@product.Name">
                    <div class="card-body text-center">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text fw-semibold text-muted">@product.Price.ToString("C")</p>
                        <a href="/Cart/Add/@product.Id" class="btn btn-outline-dark rounded-circle d-flex align-items-center justify-content-center shadow-sm hover-scale" style="width: 40px; height: 40px;">
                            <i class="bi bi-cart-plus-fill"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .category-img {
        height: 200px;
        object-fit: cover;
        border-radius: 8px;
        transition: transform .4s ease;
    }

    .category-card:hover .category-img {
        transform: scale(1.05);
    }

    .product-img {
        height: 180px;
        object-fit: cover;
        border-radius: 10px;
        transition: transform .3s ease;
    }

    .product-card:hover .product-img {
        transform: scale(1.08);
    }

    .hover-scale:hover {
        transform: scale(1.1);
        transition: .2s;
    }

    .carousel-caption {
        animation: fadeInUp 1s ease;
    }
</style>
