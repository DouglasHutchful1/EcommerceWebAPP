@{
    ViewData["Title"] = "Home";
}

<!-- AOS Animation Library -->
<link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script> AOS.init(); </script>

<!-- HERO CAROUSEL -->
<div class="p-0 mb-5 rounded-3 shadow-lg overflow-hidden position-relative">
    <div id="homeCarousel" class="carousel slide" data-bs-ride="carousel">
        
        <!-- Indicators -->
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="0" class="active"></button>
            <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="2"></button>
        </div>

        <!-- Slides -->
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="https://images.unsplash.com/photo-1582719188393-bb71ca45dbb9" class="d-block w-100" style="height:450px; object-fit:cover;">
            </div>
            <div class="carousel-item">
                <img src="https://plus.unsplash.com/premium_photo-1676057875116-159f2ef046b8" class="d-block w-100" style="height:450px; object-fit:cover;">
            </div>
            <div class="carousel-item">
                <img src="https://images.unsplash.com/photo-1492707892479-7bc8d5a4ee93" class="d-block w-100" style="height:450px; object-fit:cover;">
            </div>
        </div>

        <!-- Controls -->
        <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>

        <!-- Overlay Content -->
        <div class="carousel-caption text-start bg-dark bg-opacity-50 p-4 rounded animate__animated animate__fadeInUp">
            <h1 class="fw-bold text-white display-5">Discover Amazing Products</h1>
            <p class="text-light">Shop top categories and exclusive deals. Delivered fast to your doorstep.</p>
            <a class="btn btn-warning btn-lg rounded-pill shadow-sm px-4" href="/Products">Start Shopping</a>
        </div>
    </div>
</div>

<!-- CATEGORIES -->
<div class="container my-5">
    <h2 class="mb-4 text-center fw-bold" data-aos="fade-up">Browse by Category</h2>

    <div class="row text-center g-4">
        <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
            <div class="card border-0 shadow-sm category-card">
                <img src="https://plus.unsplash.com/premium_photo-1679079456083-9f288e224e96" class="card-img-top category-img" alt="Electronics">
                <div class="card-body">
                    <h5 class="card-title mb-2">Electronics</h5>
                    <a href="#" class="btn btn-outline-dark btn-sm rounded-pill px-4">Explore</a>
                </div>
            </div>
        </div>

        <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
            <div class="card border-0 shadow-sm category-card">
                <img src="https://plus.unsplash.com/premium_photo-1664202526559-e21e9c0fb46a" class="card-img-top category-img" alt="Fashion">
                <div class="card-body">
                    <h5 class="card-title mb-2">Fashion</h5>
                    <a href="#" class="btn btn-outline-dark btn-sm rounded-pill px-4">Explore</a>
                </div>
            </div>
        </div>

        <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
            <div class="card border-0 shadow-sm category-card">
                <img src="https://plus.unsplash.com/premium_photo-1723200799213-e6cff0c3e641" class="card-img-top category-img" alt="Home & Living">
                <div class="card-body">
                    <h5 class="card-title mb-2">Home & Living</h5>
                    <a href="#" class="btn btn-outline-dark btn-sm rounded-pill px-4">Explore</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FEATURED PRODUCTS -->
<div class="container my-5">
    <h2 class="mb-4 text-center fw-bold" data-aos="fade-up">Featured Products</h2>

    <div class="row row-cols-1 row-cols-md-4 g-4">
        @{
            var imageUrls = new[]
            {
                "https://images.unsplash.com/photo-1525966222134-fcfa99b8ae77",
                "https://images.unsplash.com/photo-1662384197911-e82189f4dc60",
                "https://images.unsplash.com/photo-1605455699691-abb8c7c8d34a",
                "https://images.unsplash.com/photo-1606760227091-3dd870d97f1d",
            };
        }

        @for (int i = 1; i <= 4; i++)
        {
            <div class="col" data-aos="fade-up" data-aos-delay="@(i * 100)">
                <div class="card h-100 border-0 shadow-sm product-card">
                    
                    <!-- Modern smaller product image -->
                    <img src="@imageUrls[i - 1]"
                         class="card-img-top product-img"
                         alt="Product @i">

                    <div class="card-body text-center">
                        <h5 class="card-title">Product Name @i</h5>
                        <p class="card-text fw-semibold text-muted">$@(19.99 + i * 5)</p>
                        
                        <a href="#" class="btn btn-outline-dark rounded-circle d-flex align-items-center justify-content-center shadow-sm hover-scale"
                           style="width: 40px; height: 40px;">
                            <i class="bi bi-cart-plus-fill"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Custom Modern Styling -->
<style>
    .category-img {
        height: 200px;
        object-fit: cover;
        border-radius: 8px;
        transition: transform .4s ease;
    }

    .category-card:hover .category-img {
        transform: scale(1.05);
    }

    .product-img {
        height: 180px;
        object-fit: cover;
        border-radius: 10px;
        transition: transform .3s ease;
    }

    .product-card:hover .product-img {
        transform: scale(1.08);
    }

    .hover-scale:hover {
        transform: scale(1.1);
        transition: .2s;
    }

    .carousel-caption {
        animation: fadeInUp 1s ease;
    }
</style>
