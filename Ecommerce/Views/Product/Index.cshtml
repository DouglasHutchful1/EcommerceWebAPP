@{
    ViewData["Title"] = "Products";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>

<div class="container my-5">

    <!-- Page Header -->
   <div class="text-center mb-5">
       <h1 class="fw-bold page-title animate__animated animate__fadeInDown">
           Explore Our Products
       </h1>
       <p class="text-muted fs-6 animate__animated animate__fadeInUp">
           Hand-picked items curated just for you
       </p>
   </div>


    <!-- Filters Row -->
 <div class="row mb-4 animate__animated animate__fadeIn">
     <div class="col-12">
         <div class="filter-bar row g-3 align-items-center">
 
             <div class="col-md-4">
                 <input type="text" id="searchInput"
                        class="form-control rounded-pill"
                        placeholder="Search products..." />
             </div>
 
             <div class="col-md-3">
                 <select id="categoryFilter" class="form-select rounded-pill">
                     <option value="">All Categories</option>
                     <option value="Electronics">Electronics</option>
                     <option value="Fashion">Fashion</option>
                     <option value="Home">Home & Living</option>
                 </select>
             </div>
 
             <div class="col-md-3">
                 <select id="sortFilter" class="form-select rounded-pill">
                     <option value="latest">Newest</option>
                     <option value="low-high">Price: Low → High</option>
                     <option value="high-low">Price: High → Low</option>
                 </select>
             </div>
 
             <div class="col-md-2">
                 <button id="filterBtn" class="btn btn-primary w-100 rounded-pill">
                     Search
                 </button>
             </div>
 
         </div>
     </div>
 </div>


    <!-- Product Grid -->
    <div class="row g-4" id="productGrid">



    </div>
</div>

<style>
body {
    background: #f7f8fb;
}

.page-title {
    letter-spacing: -0.5px;
}

.filter-bar {
    background: #ffffff;
    border-radius: 1rem;
    padding: 1rem 1.25rem;
    box-shadow: 0 10px 25px rgba(0,0,0,0.05);
}

/* === PRODUCT CARD === */
.product-card {
    border: none;
    border-radius: 18px;
    overflow: hidden;
    background: #fff;
    transition: all .35s ease;
    position: relative;
}

.product-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 18px;
    box-shadow: 0 25px 60px rgba(0,0,0,.08);
    opacity: 0;
    transition: .35s ease;
    pointer-events: none;
}

.product-card:hover::after {
    opacity: 1;
}

.product-card:hover {
    transform: translateY(-10px);
}

/* IMAGE */
.image-wrapper {
    height: 210px;
    overflow: hidden;
    position: relative;
    background: #f1f1f1;
}

.image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s ease;
}

.product-card:hover img {
    transform: scale(1.12);
}

/* badge */
.badge-new {
    position: absolute;
    top: 12px;
    right: 12px;
    background: linear-gradient(135deg, #4f46e5, #3b82f6);
    color: #fff;
    padding: 6px 14px;
    font-size: .75rem;
    border-radius: 999px;
    font-weight: 600;
    box-shadow: 0 6px 15px rgba(79,70,229,.4);
}

/* BODY */
.card-body {
    padding: 1.2rem;
}

.product-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: .25rem;
    color: #111;
}

.product-category {
    font-size: .8rem;
    color: #6b7280;
}

.product-price {
    font-size: 1.25rem;
    font-weight: 700;
    color: #2563eb;
}

/* BUTTON */
.add-cart-btn {
    border-radius: 999px;
    padding: 8px 18px;
    border: 1px solid #111;
    background: transparent;
    font-weight: 600;
    transition: all .25s ease;
}

.add-cart-btn:hover {
    background: #111;
    color: #fff;
    transform: translateY(-1px);
}

/* subtle animation */
.fade-up {
    animation: fadeUp .5s ease both;
}

@@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(16px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
</style>


<script>
async function loadProducts() {
    const search = document.getElementById("searchInput").value;
    const category = document.getElementById("categoryFilter").value;
    const sort = document.getElementById("sortFilter").value;

    const url = `/Product/GetProducts?search=${encodeURIComponent(search)}&category=${encodeURIComponent(category)}&sort=${sort}`;

    const res = await fetch(url);
    const products = await res.json();

    const grid = document.getElementById("productGrid");
    grid.innerHTML = "";

    products.forEach(p => {
        grid.innerHTML += `
        <div class="col-sm-6 col-md-4 col-lg-3 fade-up">
            <div class="product-card">
                <div class="image-wrapper">
                    <img src="${p.image}" alt="${p.name}">
                    <span class="badge-new">New</span>
                </div>

                <div class="card-body text-center">
                    <div class="product-title">${p.name}</div>
                    <div class="product-category">${p.category ?? ""}</div>

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="product-price">$${Number(p.price).toFixed(2)}</span>

                        <button type="button"
                                class="add-cart-btn"
                                data-id="${p.id}">
                            <i class="bi bi-cart-plus"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>`;
    });
}

// filter button
document.getElementById("filterBtn").addEventListener("click", loadProducts);

// add to cart
document.addEventListener("click", async (e) => {
    const btn = e.target.closest(".add-cart-btn");
    if (!btn) return;

    if (btn.dataset.loading === "1") return;

    const payload = {
        productId: parseInt(btn.dataset.id),
        quantity: 1
    };

    try {
        btn.dataset.loading = "1";
        btn.disabled = true;

        const res = await fetch("/Cart/Add", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        });

        if (res.ok) {
            if (typeof showToast === "function") showToast("success", "Added to cart");

            if (typeof window.loadCart === "function") await window.loadCart();
            if (typeof window.toggleCart === "function") await window.toggleCart();
            return;
        }

        if (res.status === 401) {
            if (typeof showToast === "function") showToast("info", "Please log in to add items to cart.");
            const modalEl = document.getElementById("loginModal");
            if (modalEl) new bootstrap.Modal(modalEl).show();
            return;
        }

        if (typeof showToast === "function") showToast("error", "Failed to add to cart.");
    } catch (err) {
        if (typeof showToast === "function") showToast("error", "Network error. Please try again.");
    } finally {
        btn.dataset.loading = "0";
        btn.disabled = false;
    }
});

document.addEventListener("DOMContentLoaded", loadProducts);
</script>


