@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DawgShop</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet"> 
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>

<style>
:root {
    --primary: #0d6efd;
    --primary-soft: #e7f1ff;
    --dark: #1c1f26;
    --muted: #6c757d;
    --bg: #f5f7fb;
    --card-bg: #ffffff;
    --radius: 14px;
    --radius-sm: 10px;
    --shadow-sm: 0 4px 14px rgba(0,0,0,.06);
    --shadow-md: 0 10px 30px rgba(0,0,0,.08);
}

/* ===== PAGE LAYOUT FIX ===== */
html, body {
    height: 100%;
}

body {
    display: flex;
    flex-direction: column;
    background: var(--bg);
    font-family: Inter, 'Segoe UI', system-ui, sans-serif;
    color: #212529;
}

main {
    flex: 1 0 auto;
}

/* ===== NAVBAR ===== */
.navbar {
    background: rgba(255,255,255,.9) !important;
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(0,0,0,.05);
}

.navbar-brand {
    font-weight: 700;
}

.nav-link {
    font-weight: 500;
    padding: .5rem .9rem;
    border-radius: 8px;
}

.nav-link:hover {
    background: var(--primary-soft);
    color: var(--primary);
}

/* ===== FOOTER FIX ===== */
footer {
    flex-shrink: 0;
    background: #0f1220;
    color: #aeb4c0;
    margin-top: 4rem;
}
footer a { color: #bbb; text-decoration: none; }
footer h5, footer h6 {
    color: #fff;
}

/* ===== MODALS ===== */
.modal-content {
    border-radius: 18px;
    box-shadow: var(--shadow-md);
}

.modal-title {
    font-weight: 700;
}

/* ===== BUTTONS ===== */
.btn {
    border-radius: 999px;
    font-weight: 500;
}

/* ===== DROPDOWNS ===== */
.dropdown-menu {
    border: none;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
    padding: .5rem;
}

/* ===== TOAST ===== */
.toast-container {
    z-index: 2000;
}

/* ===== CART OVERLAY FIX ===== */
.cart-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.4);
    z-index: 1040;
    display: none;
}

.cart-backdrop.show {
    display: block;
}

/* ===== CART DRAWER FIX (IMPORTANT) ===== */
.cart-drawer {
    position: fixed;
    top: 0;
    right: -380px;
    height: 100vh;
    width: 380px;
    background: var(--card-bg);
    box-shadow: var(--shadow-md);
    border-radius: 18px 0 0 18px;
    z-index: 1050;
    display: flex;
    flex-direction: column;
    transition: right .35s ease;
}

.cart-drawer.open {
    right: 0;
}

.cart-drawer h5 {
    font-weight: 700;
}
</style>

</head>
<body>

<!-- ========================== TOAST CONTAINER ========================== -->
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <!-- Success Toast -->
        <div id="successToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <span id="successToastMessage"></span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>

        <!-- Error Toast -->
        <div id="errorToast" class="toast align-items-center text-bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>
                    <span id="errorToastMessage"></span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>

        <!-- Info Toast -->
        <div id="infoToast" class="toast align-items-center text-bg-info border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <span id="infoToastMessage"></span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- ========================== HEADER ========================== -->
  <header class="py-2" style="background: linear-gradient(90deg,#0d6efd,#6610f2);">
      <div class="container text-center">
          <span class="text-white small fw-semibold">
              Free shipping for orders above ₵500
          </span>
      </div>
  </header>

    <!-- ========================== NAVBAR ========================== -->
    <nav class="navbar navbar-expand-lg navbar-light shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary" href="/">
                <i class="bi bi-bag-check-fill me-1"></i> DawgShop
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link active" href="/"><i class="bi bi-house-door me-1"></i>Home</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-shop me-1"></i>Store</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/Product">All Products</a></li>
                            <li><a class="dropdown-item" href="/Product">Deals & Discounts</a></li>
                            <li><a class="dropdown-item" href="/Product">New Arrivals</a></li>
                        </ul>
                    </li>
                   
                </ul>

                <!-- SEARCH -->
                <form class="d-flex me-3" role="search" onsubmit="return false;">
                    <input class="form-control form-control-sm rounded-pill me-2" type="search" placeholder="Search...">
                    <button class="btn btn-sm btn-outline-primary rounded-pill" type="button"><i class="bi bi-search"></i></button>
                </form>

                <!-- CART -->
               <button class="btn btn-sm btn-outline-secondary me-2 rounded-pill position-relative"
                       onclick="toggleCart()">
                   <i class="bi bi-cart3"></i>
                   <span id="cartCount"
                         class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                       0
                   </span>
               </button>

               
         
             <!-- ACCOUNT -->
             <div id="accountDropdown">
                 <!-- This will be populated by JavaScript -->
                 <div class="dropdown">
                     <a class="btn btn-sm btn-outline-dark dropdown-toggle rounded-pill" href="#" data-bs-toggle="dropdown">
                         <i class="bi bi-person-circle"></i> Account
                     </a>
                     <ul class="dropdown-menu dropdown-menu-end shadow">
                         <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#loginModal">Login</a></li>
                         <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#registerModal">Register</a></li>
                     </ul>
                 </div>
             </div>
            </div>
        </div>
    </nav>

    <!-- ========================== MAIN ========================== -->
    <main class="container py-4">
        @RenderBody()
    </main>

    <!-- ========================== FOOTER ========================== -->
    <footer class="pt-5 pb-4 mt-5 text-light">
        <div class="container">
            <div class="row">
                <div class="col-md-3 mb-4">
                    <h5 class="text-warning fw-bold mb-3"><i class="bi bi-bag-check-fill me-1 text-primary"></i> DawgShop</h5>
                    <p>Your one-stop shop for fashion, electronics, and home essentials.</p>
                </div>
                <div class="col-md-2 mb-4">
                    <h6 class="text-warning fw-bold mb-3">Quick Links</h6>
                    <p><a href="/Products">Products</a></p>
                    <p><a href="/Cart">Cart</a></p>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="text-warning fw-bold mb-3">Contact</h6>
                    <p><i class="bi bi-geo-alt"></i> Accra, Ghana</p>
                    <p><i class="bi bi-envelope"></i> support@dawgshop.com</p>
                    <p><i class="bi bi-phone"></i> +233 123 456 789</p>
                </div>
                <div class="col-md-4 text-center mb-4">
                    <h6 class="text-warning fw-bold mb-3">Follow Us</h6>
                    <div>
                        <a class="btn btn-outline-light btn-sm m-1"><i class="bi bi-facebook"></i></a>
                        <a class="btn btn-outline-light btn-sm m-1"><i class="bi bi-twitter"></i></a>
                        <a class="btn btn-outline-light btn-sm m-1"><i class="bi bi-instagram"></i></a>
                        <a class="btn btn-outline-light btn-sm m-1"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
            </div>
            <hr class="border-secondary">
            <div class="text-center small">&copy; 2025 DawgShop — All Rights Reserved</div>
        </div>
    </footer>

    <!-- ========================= LOGIN MODAL ========================= -->
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold text-primary"><i class="bi bi-person-circle me-1"></i> Login</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4">
                    <div id="loginFormWrapper">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email or Username</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                <input id="loginUsername" type="text" class="form-control" placeholder="Enter email or username" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                                <input id="loginPassword" type="password" class="form-control" placeholder="Enter password" required />
                            </div>
                        </div>
                        <p id="loginError" class="text-danger small"></p>
                        <button type="button" id="loginBtn" class="btn btn-primary w-100 rounded-pill">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Login
                        </button>
                    </div>
                    <div class="text-center mt-3">
                        <p class="small">Don't have an account? 
                            <a href="#" class="text-decoration-none fw-semibold" data-bs-target="#registerModal" data-bs-toggle="modal" data-bs-dismiss="modal">Register</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================= REGISTER MODAL ========================= -->
    <div class="modal fade" id="registerModal" tabindex="-1" aria-labelledby="registerModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold text-success"><i class="bi bi-person-plus-fill me-1"></i> Create Account</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4">
                    <div id="registerFormWrapper">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Firstname</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                <input id="regFirstname" type="text" class="form-control" placeholder="Enter firstname" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Lastname</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                <input id="regLastname" type="text" class="form-control" placeholder="Enter lastname" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Username</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person-badge"></i></span>
                                <input id="regUsername" type="text" class="form-control" placeholder="Choose username" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                <input id="regEmail" type="email" class="form-control" placeholder="Enter email" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                                <input id="regPassword" type="password" class="form-control" placeholder="Enter password" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Confirm Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-lock-fill"></i></span>
                                <input id="regConfirmPassword" type="password" class="form-control" placeholder="Confirm password" required />
                            </div>
                        </div>
                        <p id="registerError" class="text-danger small"></p>
                        <button type="button" id="registerBtn" class="btn btn-success w-100 rounded-pill">
                            <i class="bi bi-person-plus-fill me-1"></i> Create Account
                        </button>
                    </div>
                    <div class="text-center mt-3">
                        <p class="small">Already have an account? 
                            <a href="#" class="text-decoration-none fw-semibold text-primary" data-bs-target="#loginModal" data-bs-toggle="modal" data-bs-dismiss="modal">Login</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Navbar dropdown hover
        const dropdowns = document.querySelectorAll('.navbar .dropdown');
        dropdowns.forEach(drop => {
            drop.addEventListener('mouseover', function () {
                const toggle = drop.querySelector('[data-bs-toggle="dropdown"]');
                if (toggle && bootstrap.Dropdown.getInstance(toggle) === null) {
                    new bootstrap.Dropdown(toggle).show();
                }
            });
            drop.addEventListener('mouseleave', function () {
                const toggle = drop.querySelector('[data-bs-toggle="dropdown"]');
                if (toggle && bootstrap.Dropdown.getInstance(toggle)) {
                    bootstrap.Dropdown.getInstance(toggle).hide();
                }
            });
        });

        // Modal animations
        document.addEventListener('show.bs.modal', function (event) {
            const modal = event.target;
            const content = modal.querySelector('.modal-content');
            if (content) {
                content.classList.add('animate__animated', 'animate__fadeInUp');
            }
        });
        document.addEventListener('hidden.bs.modal', function (event) {
            const modal = event.target;
            const content = modal.querySelector('.modal-content');
            if (content) {
                content.classList.remove('animate__animated', 'animate__fadeInUp');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)



    <script>
        $(document).ready(function () {
            console.log("jQuery loaded:", typeof jQuery !== 'undefined');
       window.toggleCart = function () {
           const drawer = document.getElementById("cartDrawer");
           const backdrop = document.getElementById("cartBackdrop");
       
           if (!drawer || !backdrop) return;
       
           drawer.classList.toggle("open");
           backdrop.classList.toggle("show");
       
           if (drawer.classList.contains("open")) {
               loadCart();
           }
       }

                        
                        async function loadCart() {
                            const res = await fetch("/Cart/Get");
                            const data = await res.json();
                        
                            const container = document.getElementById("cartItems");
                            const countBadge = document.getElementById("cartCount");
                        
                            container.innerHTML = "";
                        
                            if (!data.items || data.items.length === 0) {
                                container.innerHTML = `<p class="text-muted text-center">Your cart is empty</p>`;
                                document.getElementById("cartTotal").innerText = "$0.00";
                                countBadge.textContent = "0";
                                return;
                            }
                        
                            let totalQty = 0;
                        
                            data.items.forEach(i => {
                                totalQty += i.quantity;
                        
                                container.innerHTML += `
                                    <div class="d-flex align-items-center mb-3">
                                        <img src="${i.image}" class="rounded me-2" style="width:60px;height:60px;object-fit:cover" />
                                        <div class="flex-grow-1">
                                            <div class="fw-semibold">${i.name}</div>
                                            <small>$${i.price} × ${i.quantity}</small>
                                        </div>
                                        <button class="btn btn-sm btn-outline-danger"
                                                onclick="removeFromCart(${i.productId})">
                                            ×
                                        </button>
                                    </div>
                                `;
                            });
                        
                            document.getElementById("cartTotal").innerText =
                                "$" + data.total.toFixed(2);
                        
                            countBadge.textContent = totalQty;
                        }

            
                 // ========== TOAST NOTIFICATION HELPER FUNCTIONS ==========
                    function showToast(type, message) {
                        let toastEl, messageEl;
                        
                        if (type === 'success') {
                            toastEl = document.getElementById('successToast');
                            messageEl = document.getElementById('successToastMessage');
                        } else if (type === 'error') {
                            toastEl = document.getElementById('errorToast');
                            messageEl = document.getElementById('errorToastMessage');
                        } else if (type === 'info') {
                            toastEl = document.getElementById('infoToast');
                            messageEl = document.getElementById('infoToastMessage');
                        }
                        
                        if (toastEl && messageEl) {
                            messageEl.textContent = message;
                            const toast = new bootstrap.Toast(toastEl, {
                                autohide: true,
                                delay: 4000
                            });
                            toast.show();
                        }
                    }
            
                    // Navbar dropdown hover
                    const dropdowns = document.querySelectorAll('.navbar .dropdown');
                    dropdowns.forEach(drop => {
                        drop.addEventListener('mouseover', function () {
                            const toggle = drop.querySelector('[data-bs-toggle="dropdown"]');
                            if (toggle && bootstrap.Dropdown.getInstance(toggle) === null) {
                                new bootstrap.Dropdown(toggle).show();
                            }
                        });
                        drop.addEventListener('mouseleave', function () {
                            const toggle = drop.querySelector('[data-bs-toggle="dropdown"]');
                            if (toggle && bootstrap.Dropdown.getInstance(toggle)) {
                                bootstrap.Dropdown.getInstance(toggle).hide();
                            }
                        });
                    });
            
                    // Modal animations
                    document.addEventListener('show.bs.modal', function (event) {
                        const modal = event.target;
                        const content = modal.querySelector('.modal-content');
                        if (content) {
                            content.classList.add('animate__animated', 'animate__fadeInUp');
                        }
                    });
                    document.addEventListener('hidden.bs.modal', function (event) {
                        const modal = event.target;
                        const content = modal.querySelector('.modal-content');
                        if (content) {
                            content.classList.remove('animate__animated', 'animate__fadeInUp');
                        }
                    });
            // Function to update account dropdown based on login status
                function updateAccountDropdown() {
                    $.ajax({
                        url: "/Home/GetCurrentUser",
                        type: "GET",
                        success: function(res) {
                            if (res.success && res.isLoggedIn) {
                                // User is logged in
                                $("#accountDropdown").html(`
                                    <div class="dropdown">
                                        <a class="btn btn-sm btn-outline-dark dropdown-toggle rounded-pill" href="#" data-bs-toggle="dropdown">
                                            <i class="bi bi-person-circle"></i> ${res.username}
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end shadow">
                                            <li><a class="dropdown-item" href="/Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                            <li><a class="dropdown-item" href="/Orders"><i class="bi bi-bag-check me-2"></i>My Orders</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item" href="#" id="logoutBtn"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                                        </ul>
                                    </div>
                                `);
                                
                                //  logout handler
                                $("#logoutBtn").on("click", function(e) {
                                    e.preventDefault();
                                    handleLogout();
                                });
                            } else {
                                // User is not logged in
                                $("#accountDropdown").html(`
                                    <div class="dropdown">
                                        <a class="btn btn-sm btn-outline-dark dropdown-toggle rounded-pill" href="#" data-bs-toggle="dropdown">
                                            <i class="bi bi-person-circle"></i> Account
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end shadow">
                                            <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#loginModal"><i class="bi bi-box-arrow-in-right me-2"></i>Login</a></li>
                                            <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#registerModal"><i class="bi bi-person-plus me-2"></i>Register</a></li>
                                        </ul>
                                    </div>
                                `);
                            }
                        },
                        error: function() {
                            console.error("Failed to get user status");
                        }
                    });
                }
            
                // Logout function
                function handleLogout() {
                    $.ajax({
                        url: "/Home/Logout",
                        type: "POST",
                        success: function(res) {
                            if (res.success) {
                                showToast('success', 'Logged out successfully!');
                                
                                    location.reload();
                            }
                        },
                        error: function() {
                            showToast('error', 'Logout failed. Please try again.');
                        }
                    });
                }
            
                // Call on page load
                $(document).ready(function() {
                    updateAccountDropdown();
                });

            // -------- LOGIN BUTTON  ----------
     $("#loginBtn").on("click", function (e) {
         e.preventDefault();
         e.stopPropagation();
         
         console.log("Login button clicked");
         
         $("#loginError").text("");
         
         $.ajax({
             url: "/Home/Login",
             type: "POST",
             data: {
                 username: $("#loginUsername").val(),
                 password: $("#loginPassword").val()
             },
             success: function (res) {
                 console.log("Login response:", res);
     
                 if (res.success) {
     
                     $("#loginError").text("");
                     $("#loginModal").modal("hide");
                     showToast('success', 'Login successful! Redirecting...');
     
                     // Update navbar account dropdown
                     $("#accountDropdown").html(`
                         <div class="dropdown">
                             <a class="btn btn-sm btn-outline-dark dropdown-toggle rounded-pill" href="#" data-bs-toggle="dropdown">
                                 <i class="bi bi-person-circle"></i> ${res.username}
                             </a>
                             <ul class="dropdown-menu dropdown-menu-end shadow">
                                 <li><a class="dropdown-item" href="/Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                 <li><a class="dropdown-item" href="/Orders"><i class="bi bi-bag-check me-2"></i>My Orders</a></li>
                                 <li><hr class="dropdown-divider"></li>
                                 <li><a class="dropdown-item" href="#" id="logoutBtn"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                             </ul>
                         </div>
                     `);
     
                     // Logout handler
                     $("#logoutBtn").on("click", function(e) {
                         e.preventDefault();
                         handleLogout();
                     });
     
                     $("#loginUsername, #loginPassword").val("");
     
                     if (res.redirect) {
                         setTimeout(() => {
                             window.location.href = res.redirect;
                         }, 800); 
                     }
     
                 } else {
                     $("#loginError").text(res.message);
                     showToast('error', res.message);
                 }
             },
             error: function (xhr) {
                 console.log("Login error:", xhr);
                 const msg = xhr.responseJSON?.message || "Login failed";
                 $("#loginError").text(msg);
                 showToast('error', msg);
             }
         });
         
         return false;
     });

            // Handle Enter key in login form
            $("#loginUsername, #loginPassword").on("keypress", function(e) {
                if (e.which === 13) {
                    e.preventDefault();
                    $("#loginBtn").click();
                }
            });

            // -------- REGISTER BUTTON CLICK ----------
            $("#registerBtn").on("click", function (e) {
                e.preventDefault();
                e.stopPropagation();
                
                console.log("Register button clicked");
                
                const pwd = $("#regPassword").val();
                const confirm = $("#regConfirmPassword").val();
                
                if (pwd !== confirm) {
                    $("#registerError").text("Passwords do not match.");
                    showToast('error', 'Passwords do not match.');
                    return false;
                }
                
                $("#registerError").text("");
                
                const data = {
                    Firstname: $("#regFirstname").val(),
                    Lastname: $("#regLastname").val(),
                    Username: $("#regUsername").val(),
                    Email: $("#regEmail").val(),
                    Password: pwd,
                    ConfirmPassword: confirm
                };
                
                console.log("Sending registration data:", data);
                
                $.ajax({
                    url: "/Home/Register",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(data),
                    success: function (res) {
                        console.log("Register response:", res);
                        if (res.success) {
                            $("#registerError").text("");
                            $("#registerModal").modal("hide");
                            showToast('success', 'Registration successful! You can now log in.');
                       $("#regFirstname, #regLastname, #regUsername, #regEmail, #regPassword, #regConfirmPassword").val("");
                            setTimeout(function() {
                                $("#loginModal").modal("show");
                            }, 1500);
                        } else {
                            $("#registerError").text(res.message || "Registration failed");
                            showToast('error', res.message || "Registration failed");
                        }
                    },
                    error: function (xhr) {
                        console.log("Register error:", xhr);
                        const msg = xhr.responseJSON?.message || "Registration failed";
                        $("#registerError").text(msg);
                        showToast('error', msg);
                    }
                });
                
                return false;
            });
            
       
            // Handle Enter key in register form
            $("#regFirstname, #regLastname, #regUsername, #regEmail, #regPassword, #regConfirmPassword").on("keypress", function(e) {
                if (e.which === 13) {
                    e.preventDefault();
                    $("#registerBtn").click();
                }
            });
        });
    </script>
